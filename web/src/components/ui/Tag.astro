---
interface Props {
  label: string;
  dot?: string;
  onColor?: boolean;
}

const { label, dot, onColor } = Astro.props;
---

<span class:list={["tag", { "on-color": onColor }]}>
  {dot && <span class="dot" style={`background:${dot}`}></span>}
  {label}
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-pill);
    background: var(--surface-hover);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .tag.on-color {
    background: rgba(18, 23, 25, 0.12);
    color: var(--tone-ink);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
</style>
