---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { config } from "../../lib/config";

export function getStaticPaths() {
  return config.taskIds.map((task) => ({ params: { task } }));
}

const { task } = Astro.params;
---

<BaseLayout title={`Annotate ${task} — Trace`} description="Mark the moment the grasp failed. Verified by physics, paid on Monad." theme="dark">
  <main class="annotate" data-task={task}>
    <header class="top">
      <a class="mark" href="/">trace<span aria-hidden="true"></span></a>
      <div class="wallet">
        <span class="mono" data-earned>—</span>
        <span class="chip mono" data-burner>…</span>
      </div>
    </header>

    <p class="task-line mono" data-task-line>Loading task…</p>
    <h1>Mark the moment the gripper loses the cup.</h1>
    <p class="hint">Play the clip, watch the contact-force line, and scrub to where it drops.</p>

    <section class="player" aria-label="Clip">
      <div class="video-wrap">
        <video data-video playsinline muted preload="auto"></video>
        <span class="lease mono" data-lease></span>
      </div>
      <canvas data-graph aria-label="Contact force and joint torque over the clip. Tap to seek."></canvas>
      <div class="legend mono"><span class="k force">contact force</span><span class="k torque">joint torque</span><span data-time>0.00 s</span></div>
      <input class="scrub" data-scrub type="range" min="0" max="12" step="0.01" value="0" aria-label="Clip time" />
      <div class="transport">
        <button type="button" class="round" data-step="-0.1" aria-label="Back 0.1 seconds">−0.1</button>
        <button type="button" class="round" data-step="-0.0333" aria-label="Back one frame">−1f</button>
        <button type="button" class="round play" data-play aria-label="Play">▶</button>
        <button type="button" class="round" data-step="0.0333" aria-label="Forward one frame">+1f</button>
        <button type="button" class="round" data-step="0.1" aria-label="Forward 0.1 seconds">+0.1</button>
      </div>
    </section>

    <section class="grasp" data-grasp hidden aria-label="Grasp point">
      <p class="hint">Tap where the gripper should hold the cup so the grasp survives the lift.</p>
      <div class="grasp-frame" data-grasp-frame role="button" tabindex="0" aria-label="Zoomed frame at 1.00 s. Tap to place the grasp point." style="--crop-x: 0.46; --crop-y: 0.33; --crop-w: 0.36; --crop-h: 0.36">
        <img data-thumb alt="The cup on the table at 1.00 s" />
        <span class="dot" data-grasp-dot hidden></span>
      </div>
    </section>

    <section class="answer" aria-label="Your answer">
      <div class="types" role="radiogroup" aria-label="What happened">
        <button type="button" role="radio" aria-checked="true" data-type="contact_lost">Contact lost</button>
        <button type="button" role="radio" aria-checked="false" data-type="collision">Collision</button>
      </div>
      <button type="button" class="mark-btn" data-mark>Mark failure here</button>
      <button type="button" class="submit" data-submit disabled>Submit</button>
      <p class="status" data-status role="status"></p>
    </section>

    <section class="result" data-result hidden aria-live="polite">
      <div class="verdict"><strong data-verdict></strong><span class="mono" data-score></span></div>
      <p data-reason></p>
      <p class="mono chain" data-chain></p>
      <button type="button" class="next" data-next>Next clip →</button>
    </section>

    <section class="share" data-share hidden aria-live="polite">
      <div><small>License share</small><strong class="mono" data-claimable></strong><span data-share-note></span></div>
      <button type="button" class="claim" data-claim>Claim</button>
    </section>

    <div class="toast mono" data-toast hidden></div>

    <details class="key">
      <summary>Your burner wallet</summary>
      <p>Trace made a burner address for you on this device. A relayer pays all gas. Payouts and dataset tokens go to this address. Clearing this browser’s data deletes the key, so copy it if you want to keep what you earned.</p>
      <p class="mono" data-key-note></p>
      <button type="button" class="ghost" data-copy-key>Copy private key</button>
    </details>
  </main>
</BaseLayout>

<style>
  .annotate {
    display: grid;
    gap: var(--space-lg);
    max-width: 560px;
    margin: 0 auto;
    padding: calc(env(safe-area-inset-top) + var(--space-md)) var(--gutter) var(--space-block);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--touch);
  }
  .mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.04em;
  }
  .mark span {
    width: 8px;
    height: 8px;
    background: var(--accent);
  }
  .wallet {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 13px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0 var(--space-md);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .task-line,
  .hint,
  .status {
    font-size: 13px;
    color: var(--muted);
  }
  h1 {
    font-size: 26px;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .player {
    display: grid;
    gap: var(--space-sm);
  }
  .video-wrap {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface);
    aspect-ratio: 4 / 3;
  }
  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lease {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: 2px var(--space-sm);
    border-radius: var(--radius-pill);
    background: rgba(13, 17, 22, 0.7);
    color: #e6ebf0;
    font-size: 11px;
  }
  .lease:empty {
    display: none;
  }
  canvas {
    display: block;
    width: 100%;
    height: 150px;
    border-radius: var(--radius);
    background: var(--surface);
    touch-action: none;
    cursor: crosshair;
  }
  .legend {
    display: flex;
    gap: var(--space-md);
    font-size: 11px;
    color: var(--muted);
  }
  .legend [data-time] {
    margin-left: auto;
    color: var(--ink);
  }
  .k::before {
    content: "";
    display: inline-block;
    width: 10px;
    height: 2px;
    margin-right: 6px;
    vertical-align: middle;
  }
  .k.force::before {
    background: var(--scan);
  }
  .k.torque::before {
    background: var(--muted);
  }
  .scrub {
    width: 100%;
    min-height: var(--touch);
    accent-color: var(--accent);
  }
  .transport {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
  }
  .round {
    min-width: var(--touch);
    min-height: var(--touch);
    padding: 0 var(--space-md);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .round.play {
    min-width: 56px;
    background: var(--ink);
    color: var(--paper);
  }
  .grasp {
    display: grid;
    gap: var(--space-sm);
  }
  .grasp[hidden],
  .dot[hidden] {
    display: none;
  }
  .grasp-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    aspect-ratio: 4 / 3;
    background: var(--surface);
    cursor: crosshair;
    touch-action: manipulation;
  }
  .grasp-frame img {
    position: absolute;
    display: block;
    max-width: none;
    width: calc(100% / var(--crop-w));
    height: calc(100% / var(--crop-h));
    left: calc(-100% * var(--crop-x) / var(--crop-w));
    top: calc(-100% * var(--crop-y) / var(--crop-h));
  }
  .dot {
    position: absolute;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    border-radius: 50%;
    border: 3px solid var(--accent);
    box-shadow: 0 0 0 2px var(--tone-ink);
    pointer-events: none;
  }
  .answer {
    display: grid;
    gap: var(--space-sm);
  }
  .types {
    display: flex;
    gap: var(--space-sm);
  }
  .types button {
    flex: 1;
    min-height: var(--touch);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--muted);
    font-size: 14px;
  }
  .types button[aria-checked="true"] {
    background: var(--ink);
    color: var(--paper);
  }
  .mark-btn,
  .submit,
  .next {
    min-height: 52px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 600;
  }
  .mark-btn {
    box-shadow: inset 0 0 0 1.5px var(--accent);
    color: var(--accent-text);
  }
  .submit,
  .next {
    background: var(--accent);
    color: var(--on-accent);
  }
  .submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .result {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg);
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .share {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg);
    border-radius: var(--radius-card);
    background: var(--tone-signal);
    color: var(--tone-ink);
  }
  .share div {
    display: grid;
    gap: 2px;
  }
  .share small {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .share strong {
    font-size: 24px;
  }
  .share span {
    font-size: 12px;
  }
  .claim {
    min-height: var(--touch);
    padding: 0 var(--space-xl);
    border-radius: var(--radius-pill);
    background: var(--tone-ink);
    color: var(--tone-signal);
    font-weight: 600;
  }
  .claim:disabled {
    opacity: 0.5;
  }
  .result[hidden],
  .share[hidden],
  .toast[hidden] {
    display: none;
  }
  .verdict {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 22px;
  }
  .result.pass .verdict strong {
    color: var(--ok);
  }
  .result.fail .verdict strong {
    color: var(--bad);
  }
  .result p {
    color: var(--muted);
  }
  .chain {
    font-size: 12px;
    word-break: break-all;
  }
  .chain :global(a) {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .toast {
    position: fixed;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom) + var(--space-xl));
    transform: translateX(-50%);
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
    animation: pop 2.8s ease forwards;
    z-index: 20;
  }
  @keyframes pop {
    0% { opacity: 0; transform: translate(-50%, 12px); }
    10%, 85% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 0); }
  }
  .key {
    font-size: 13px;
    color: var(--muted);
  }
  .key summary {
    min-height: var(--touch);
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .key p + p,
  .key .ghost {
    margin-top: var(--space-sm);
  }
  .ghost {
    min-height: var(--touch);
    padding: 0 var(--space-lg);
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  @media (prefers-reduced-motion: reduce) {
    .toast {
      animation: none;
    }
  }
</style>

<script>
  import { config, txLink, shortHex, usdc } from "../../lib/config";
  import { loadBurner } from "../../lib/burner";
  import { balanceOf } from "../../lib/chain";
  import type { Address } from "viem";

  type Task = {
    slug: string;
    taskId: string;
    payPerItem: string;
    remainingCap: number | null;
    usdc: Address;
    dataset: Address;
    rules: { min_dwell_ms: number; lease_s: number; grasp_point?: { enabled: boolean } };
  };
  type Lease = { clipId: string; leaseId: string; expiresAt: number; videoUrl: string; sensorsUrl: string; thumbUrl: string };
  type Sensors = { duration_s: number; rate_hz: number; series: { gripper_contact_force_n: number[]; joint_torque_nm: Record<string, number[]> } };
  type Attempt = { status: string; txHash: string | null; paid: string | null };
  type Holder = { claimable: string; withdrawn: string; pendingClaim: string | null };
  type Claim = { status: string; txHash: string | null; amount: string | null };

  const root = document.querySelector<HTMLElement>(".annotate")!;
  const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
  const slug = root.dataset.task!;
  const video = $<HTMLVideoElement>("[data-video]");
  const canvas = $<HTMLCanvasElement>("[data-graph]");
  const scrub = $<HTMLInputElement>("[data-scrub]");
  const play = $<HTMLButtonElement>("[data-play]");
  const markBtn = $<HTMLButtonElement>("[data-mark]");
  const submitBtn = $<HTMLButtonElement>("[data-submit]");
  const status = $<HTMLElement>("[data-status]");
  const result = $<HTMLElement>("[data-result]");
  const toast = $<HTMLElement>("[data-toast]");
  const leaseEl = $<HTMLElement>("[data-lease]");
  const timeEl = $<HTMLElement>("[data-time]");

  const burner = loadBurner();
  $<HTMLElement>("[data-burner]").textContent = shortHex(burner.address);
  $<HTMLElement>("[data-key-note]").textContent = burner.persisted
    ? burner.address
    : "This browser blocks storage, so the key lives only until you close the tab.";
  $<HTMLButtonElement>("[data-copy-key]").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(burner.key);
      status.textContent = "Private key copied. Anyone with it controls this address.";
    } catch {
      status.textContent = "Copy failed. Your browser blocked clipboard access.";
    }
  });

  let task: Task | null = null;
  let lease: Lease | null = null;
  let sensors: Sensors | null = null;
  let mark: number | null = null;
  let grasp: { x: number; y: number } | null = null;
  const graspFrame = $<HTMLElement>("[data-grasp-frame]");
  const graspDot = $<HTMLElement>("[data-grasp-dot]");
  const needsGrasp = () => Boolean(task?.rules.grasp_point?.enabled);

  const cropOf = () => {
    const css = getComputedStyle(graspFrame);
    const v = (k: string) => Number(css.getPropertyValue(k));
    return { x: v("--crop-x"), y: v("--crop-y"), w: v("--crop-w"), h: v("--crop-h") };
  };

  function placeGrasp(viewX: number, viewY: number) {
    const c = cropOf();
    grasp = { x: Math.round((c.x + viewX * c.w) * 10000) / 10000, y: Math.round((c.y + viewY * c.h) * 10000) / 10000 };
    graspDot.hidden = false;
    graspDot.style.left = `${viewX * 100}%`;
    graspDot.style.top = `${viewY * 100}%`;
  }

  graspFrame.addEventListener("pointerdown", (e) => {
    const r = graspFrame.getBoundingClientRect();
    placeGrasp((e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height);
  });
  graspFrame.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    e.preventDefault();
    placeGrasp(0.5, 0.5);
  });
  let kind = "contact_lost";
  let loadedAt = 0;
  let earned = 0n;
  let tokens = 0n;

  function api(path: string, init?: RequestInit) {
    if (!config.apiUrl) throw new Error("PUBLIC_API_URL is not set");
    return fetch(`${config.apiUrl}${path}`, init);
  }

  async function json<T>(res: Response): Promise<T> {
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.detail ?? `${res.status} ${res.statusText}`);
    return body as T;
  }

  function showEarned() {
    const whole = Number(tokens / 10n ** 16n) / 100;
    $<HTMLElement>("[data-earned]").textContent = `${usdc(earned)} · ${whole} ${config.datasetSymbol}`;
  }

  async function refreshBalances() {
    if (task && config.rpcUrl) {
      try {
        [earned, tokens] = await Promise.all([balanceOf(task.usdc, burner.address), balanceOf(task.dataset, burner.address)]);
      } catch {}
    }
    showEarned();
  }

  const share = $<HTMLElement>("[data-share]");
  const claimBtn = $<HTMLButtonElement>("[data-claim]");

  function popToast(text: string) {
    toast.hidden = false;
    toast.textContent = text;
    setTimeout(() => (toast.hidden = true), 2800);
  }

  async function refreshShare() {
    try {
      const h = await json<Holder>(await api(`/holders/${burner.address}`));
      const claimable = BigInt(h.claimable);
      share.hidden = claimable === 0n && !h.pendingClaim;
      $<HTMLElement>("[data-claimable]").textContent = usdc(claimable);
      $<HTMLElement>("[data-share-note]").textContent = h.pendingClaim ? "Claim on its way…" : `Your cut of dataset license fees · ${usdc(h.withdrawn)} claimed so far`;
      claimBtn.disabled = claimable === 0n || Boolean(h.pendingClaim);
    } catch {}
  }

  claimBtn.addEventListener("click", async () => {
    claimBtn.disabled = true;
    try {
      const c = await json<{ claimId: string }>(
        await api("/claims", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ holder: burner.address }) }),
      );
      $<HTMLElement>("[data-share-note]").textContent = "Relayer is paying the gas…";
      for (let i = 0; i < 150; i++) {
        const r = await json<Claim>(await api(`/claims/${c.claimId}`));
        if (r.status === "pending") {
          await new Promise((res) => setTimeout(res, 200));
          continue;
        }
        if (r.status === "confirmed" && r.amount) {
          popToast(`+${usdc(r.amount)} license share`);
          refreshBalances();
        }
        break;
      }
    } catch (e) {
      $<HTMLElement>("[data-share-note]").textContent = (e as Error).message;
    }
    refreshShare();
  });

  function draw() {
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
    }
    const ctx = canvas.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    if (!sensors) return;
    const s = sensors;
    const css = getComputedStyle(root);
    const x = (t: number) => 8 + (t / s.duration_s) * (w - 16);
    const pad = 12;
    const line = (values: number[], max: number, min: number, color: string, width: number) => {
      ctx.beginPath();
      values.forEach((v, i) => {
        const px = x(i / s.rate_hz);
        const py = h - pad - ((v - min) / (max - min || 1)) * (h - 2 * pad);
        if (i) ctx.lineTo(px, py);
        else ctx.moveTo(px, py);
      });
      ctx.strokeStyle = color;
      ctx.lineWidth = width;
      ctx.stroke();
    };
    const torques = Object.values(s.series.joint_torque_nm);
    const tMax = Math.max(1, ...torques.flat().map(Math.abs));
    ctx.globalAlpha = 0.35;
    for (const series of torques) line(series, tMax, -tMax, css.getPropertyValue("--muted"), 1);
    ctx.globalAlpha = 1;
    const force = s.series.gripper_contact_force_n;
    line(force, Math.max(1, ...force), 0, css.getPropertyValue("--scan"), 2);
    if (mark !== null) {
      ctx.fillStyle = css.getPropertyValue("--accent");
      ctx.fillRect(x(mark) - 1, 0, 2, h);
    }
    ctx.fillStyle = css.getPropertyValue("--ink");
    ctx.fillRect(x(video.currentTime) - 0.5, 0, 1, h);
  }

  function updateSubmit() {
    if (!task || !lease || mark === null || (needsGrasp() && !grasp)) {
      submitBtn.disabled = true;
      submitBtn.textContent = mark !== null && needsGrasp() && !grasp ? "Tap a grasp point" : "Submit";
      return;
    }
    const wait = task.rules.min_dwell_ms - (performance.now() - loadedAt);
    submitBtn.disabled = wait > 0;
    submitBtn.textContent = wait > 0 ? `Watch ${Math.ceil(wait / 1000)} s more` : `Submit ${mark.toFixed(2)} s`;
  }

  function tick() {
    timeEl.textContent = `${video.currentTime.toFixed(2)} s`;
    if (document.activeElement !== scrub) scrub.value = String(video.currentTime);
    markBtn.textContent = `Mark failure at ${video.currentTime.toFixed(2)} s`;
    if (lease) {
      const left = Math.max(0, Math.round(lease.expiresAt - Date.now() / 1000));
      leaseEl.textContent = left > 0 ? `lease ${left} s` : "lease expired";
    } else {
      leaseEl.textContent = "";
    }
    draw();
    updateSubmit();
    requestAnimationFrame(tick);
  }

  async function loadClip() {
    result.hidden = true;
    result.classList.remove("pass", "fail");
    mark = null;
    grasp = null;
    graspDot.hidden = true;
    status.textContent = "Loading clip…";
    lease = await json<Lease>(await api(`/t/${slug}/next?player=${burner.address}`));
    sensors = await json<Sensors>(await fetch(lease.sensorsUrl));
    scrub.max = String(sensors.duration_s);
    video.src = lease.videoUrl;
    $<HTMLElement>("[data-grasp]").hidden = !needsGrasp();
    if (needsGrasp()) $<HTMLImageElement>("[data-thumb]").src = lease.thumbUrl;
    video.currentTime = 0;
    loadedAt = performance.now();
    status.textContent = `Clip ${lease.clipId}`;
  }

  async function init() {
    try {
      task = await json<Task>(await api(`/t/${slug}?player=${burner.address}`));
      const cap = task.remainingCap === null ? "" : ` · ${task.remainingCap} paid marks left for you`;
      $<HTMLElement>("[data-task-line]").textContent = `${task.slug} · ${usdc(task.payPerItem)} per verified mark${cap}`;
      await refreshBalances();
      refreshShare();
      setInterval(refreshShare, 10000);
      await loadClip();
    } catch (e) {
      status.textContent = `Could not reach the coordinator: ${(e as Error).message}`;
      $<HTMLElement>("[data-task-line]").textContent = config.apiUrl || "PUBLIC_API_URL is not set";
    }
  }

  async function settle(attemptId: string, startedAt: number) {
    const chain = $<HTMLElement>("[data-chain]");
    chain.textContent = "2 of 3 nodes signed · recording on Monad…";
    for (let i = 0; i < 150; i++) {
      const a = await json<Attempt>(await api(`/attempts/${attemptId}`));
      if (a.status === "pending") {
        await new Promise((r) => setTimeout(r, 200));
        continue;
      }
      if (a.status !== "confirmed" || !a.txHash) {
        chain.textContent = "The chain did not confirm this attempt yet. Your verdict is saved.";
        return;
      }
      const ms = Math.round(performance.now() - startedAt);
      const paid = a.paid && a.paid !== "0";
      chain.textContent = `${paid ? "Paid" : "Recorded"} on Monad · ${ms} ms from tap · `;
      const link = txLink(a.txHash);
      const tx = document.createElement(link ? "a" : "span");
      tx.textContent = shortHex(a.txHash, 10, 6);
      if (link && tx instanceof HTMLAnchorElement) {
        tx.href = link;
        tx.target = "_blank";
        tx.rel = "noopener";
      }
      chain.append(tx);
      if (paid) {
        popToast(`+${usdc(a.paid!)} · +1 ${config.datasetSymbol}`);
        earned += BigInt(a.paid!);
        tokens += 10n ** 18n;
        showEarned();
        refreshBalances();
      }
      return;
    }
    chain.textContent = "Still waiting for the chain. Check back in a moment.";
  }

  play.addEventListener("click", () => (video.paused ? video.play() : video.pause()));
  video.addEventListener("play", () => {
    play.textContent = "❚❚";
    play.setAttribute("aria-label", "Pause");
  });
  video.addEventListener("pause", () => {
    play.textContent = "▶";
    play.setAttribute("aria-label", "Play");
  });
  scrub.addEventListener("input", () => {
    video.pause();
    video.currentTime = Number(scrub.value);
  });
  for (const b of root.querySelectorAll<HTMLButtonElement>("[data-step]")) {
    b.addEventListener("click", () => {
      video.pause();
      video.currentTime = Math.max(0, Math.min(video.duration || 12, video.currentTime + Number(b.dataset.step)));
    });
  }
  canvas.addEventListener("pointerdown", (e) => {
    if (!sensors) return;
    const r = canvas.getBoundingClientRect();
    video.pause();
    video.currentTime = Math.max(0, Math.min(sensors.duration_s, ((e.clientX - r.left - 8) / (r.width - 16)) * sensors.duration_s));
  });
  for (const b of root.querySelectorAll<HTMLButtonElement>("[data-type]")) {
    b.addEventListener("click", () => {
      kind = b.dataset.type!;
      for (const o of root.querySelectorAll("[data-type]")) o.setAttribute("aria-checked", String(o === b));
    });
  }
  markBtn.addEventListener("click", () => {
    video.pause();
    mark = Math.round(video.currentTime * 1000) / 1000;
    status.textContent = `Marked ${kind.replace("_", " ")} at ${mark.toFixed(2)} s`;
  });

  submitBtn.addEventListener("click", async () => {
    if (!task || !lease || mark === null) return;
    submitBtn.disabled = true;
    const startedAt = performance.now();
    const body = JSON.stringify({
      schema_version: "1.0",
      task_id: task.taskId,
      clip_id: lease.clipId,
      player: burner.address,
      lease_id: lease.leaseId,
      kind: "annotation",
      failure_moment: { t: mark, type: kind },
      grasp_point: needsGrasp() ? grasp : null,
      dwell_ms: Math.round(performance.now() - loadedAt),
      client: "web-0.1.0",
    });
    status.textContent = "Checking against physics on 3 nodes…";
    try {
      const res = await json<{ attemptId: string; passed: boolean; score: number; reason: string }>(
        await api("/annotations", { method: "POST", headers: { "Content-Type": "application/json" }, body }),
      );
      lease = null;
      status.textContent = "";
      result.hidden = false;
      result.classList.add(res.passed ? "pass" : "fail");
      $<HTMLElement>("[data-verdict]").textContent = res.passed ? "Passed" : "Missed";
      $<HTMLElement>("[data-score]").textContent = res.passed ? `score ${res.score}` : "";
      $<HTMLElement>("[data-reason]").textContent = res.reason;
      await settle(res.attemptId, startedAt);
    } catch (e) {
      status.textContent = (e as Error).message;
      updateSubmit();
    }
  });

  $<HTMLButtonElement>("[data-next]").addEventListener("click", () => {
    loadClip().catch((e) => (status.textContent = (e as Error).message));
  });

  init();
  requestAnimationFrame(tick);
</script>
