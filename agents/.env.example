# All private keys for Monaid live here (agents/.env, git-ignored). Contracts scripts read this file too.
# Never paste keys by hand: create them with `npm run wallet:new -- <NAME>` (prints addresses only).
DEPLOYER_PRIVATE_KEY=
AGENT_1_PRIVATE_KEY=
AGENT_2_PRIVATE_KEY=
# Optional RPC override (default https://testnet-rpc.monad.xyz)
MONAD_RPC_URL=
