# Copy this file to .env and add a private key that holds Monad Testnet MON.
PRIVATE_KEY=0xyour_private_key
# Optional. The default is https://testnet-rpc.monad.xyz
# MONAD_TESTNET_RPC_URL=
# Optional. Tickets that 1 USDC earns for 1 full day. The default is 0.1 (10 USDC = 1 Ticket).
# TICKETS_PER_USDC_PER_DAY=0.1
# Optional. Seconds in one day. The default is 10 for the demo. Use 86400 for real days.
# DAY_LENGTH_SECONDS=10
# Optional. Keep an existing MockUSDC instead of deploying a new one.
# USDC_ADDRESS=0x...
